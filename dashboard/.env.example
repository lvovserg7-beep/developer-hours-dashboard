# База trade — Аллсан Интеграция
ODATA_DB_TRADE_BASE_URL=https://trade.alsn.ru/trade/odata/standard.odata/
ODATA_DB_TRADE_USERNAME=
ODATA_DB_TRADE_PASSWORD=

# База ecotidy — Первый интегратор
ODATA_DB_ECOTIDY_BASE_URL=https://demo.alsn.ru/ecotidy/odata/standard.odata/
ODATA_DB_ECOTIDY_USERNAME=
ODATA_DB_ECOTIDY_PASSWORD=

# База по умолчанию для запросов без явного database
ODATA_DEFAULT_DB=trade

# Входящий webhook Bitrix24 (секрет в пути — не коммитить)
BITRIX24_WEBHOOK_URL=https://alsn.bitrix24.ru/rest/{user_id}/{code}/

# Первый администратор дашборда (создаётся только если ещё нет users.json)
DASHBOARD_ADMIN_LOGIN=admin
DASHBOARD_ADMIN_PASSWORD=
# Необязательно: секрет подписи cookie. Если пусто — генерируется сам.
DASHBOARD_SESSION_SECRET=
