# База trade — Аллсан Интеграция
ODATA_DB_TRADE_BASE_URL=https://trade.alsn.ru/trade/odata/standard.odata/
ODATA_DB_TRADE_USERNAME=
ODATA_DB_TRADE_PASSWORD=

# База ecotidy — Первый интегратор
ODATA_DB_ECOTIDY_BASE_URL=https://demo.alsn.ru/ecotidy/odata/standard.odata/
ODATA_DB_ECOTIDY_USERNAME=
ODATA_DB_ECOTIDY_PASSWORD=

# База по умолчанию для запросов без явного database
ODATA_DEFAULT_DB=trade

# Входящий webhook Bitrix24 (секрет в пути — не коммитить)
BITRIX24_WEBHOOK_URL=https://alsn.bitrix24.ru/rest/{user_id}/{code}/

# Google Search Console (service account JSON + свойство)
# GSC_CREDENTIALS_PATH=./secrets/gsc-service-account.json
# GSC_SITE_URL=sc-domain:alsn.ru
# GSC_SITE_URLS=sc-domain:alsn.ru,sc-domain:ecotidy.ru

# Яндекс.Вебмастер (OAuth-токен)
# YANDEX_WEBMASTER_TOKEN=
# YANDEX_WEBMASTER_HOST_IDS=https:alsn.ru:443,https:ecotidy.ru:443
# SEO_LOOKBACK_DAYS=90
# Раз в сутки и при старте перечитываются последние N дней (сайт, позиции, Wordstat).
# SEO_REFRESH_MS=86400000
# При старте (start.cmd / node server.mjs): сброс периодного кэша за окно + перечитывание SEO и Озон.
# CACHE_TRAILING_DAYS=7
# CACHE_TRAILING_STARTUP=1
# CACHE_TRAILING_OZON=1
# Первый вход в дашборд за календарный день → пересчёт кэша только за вчера.
# CACHE_FIRST_OPEN_DAY=1

# Яндекс.Wordstat v2 (частота запросов на доске позиций) — Yandex Cloud Search API
# YANDEX_WORDSTAT_API_KEY=   # или YANDEX_SEARCH_API_KEY
# YANDEX_FOLDER_ID=          # или YANDEX_WORDSTAT_FOLDER_ID
# WORDSTAT_CACHE_DAYS=7
# Устаревший OAuth Wordstat (если ещё выдан): YANDEX_WORDSTAT_TOKEN=

# Ozon Seller API — вкладка «Отгрузки ФБС ozon»
# OZON_SELLER_CLIENT_ID=
# OZON_SELLER_API_KEY=

# Первый администратор дашборда (создаётся только если ещё нет users.json)
DASHBOARD_ADMIN_LOGIN=admin
DASHBOARD_ADMIN_PASSWORD=
# Необязательно: секрет подписи cookie. Если пусто — генерируется сам.
DASHBOARD_SESSION_SECRET=
